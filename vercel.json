{
	"builds": [
		{
			"src": "config/wsgi.py",
			"use": "@vercel/python",
			"config": {
				"maxDuration": 60,
				"includeFiles": "locale/**"
			}
		}
	],
	"routes": [
		{
		"src": "/(.*)",
		"dest": "config/wsgi.py"
		}
	],
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"regions": ["fra1"]
}
